# ELEVENLABS_API_KEY: required — voice generation (TTS).
# Get it from ElevenLabs > Developers / API Keys.
# The key must have: Text to Speech = Access, Voices = Read.
# Never commit a real key to git. On Render, set it in the dashboard
# (Environment > Add Environment Variable), not in this file.
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# GEMINI_API_KEY: optional — only for AI script writing
# (/api/script/generate and /api/script/chat). Without it the app still
# works: you can type the script manually and generate the voice with
# ElevenLabs. If set, put the real value in Render's dashboard too.
GEMINI_API_KEY=

# PORT is set automatically by Render. Locally it defaults to 3000.
# NODE_ENV=production makes the server serve the built frontend from dist/.
